{
  "name": "solobill",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n api,ui -c blue,green \"pnpm dev:api\" \"pnpm dev:ui\"",
    "dev:api": "node --watch --env-file-if-exists=.env src/server/index.ts",
    "dev:ui": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "openapi": "node src/server/scripts/openapi.ts",
    "ios:fixtures": "WRITE_IOS_FIXTURES=1 vitest run src/server/test/api-contract.test.ts",
    "demo": "node src/server/scripts/demo-data.ts",
    "admin": "node --env-file-if-exists=.env src/server/scripts/admin.ts",
    "backup": "node --env-file-if-exists=.env src/server/scripts/backup.ts",
    "restore": "node --env-file-if-exists=.env src/server/scripts/restore.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@cantoo/pdf-lib": "^2.11.1",
    "@hono/node-server": "^2.1.6",
    "better-sqlite3": "^13.0.3",
    "bidi-js": "^1.1.0",
    "croner": "^11.0.0",
    "drizzle-orm": "^0.45.4",
    "fontkit": "^2.0.4",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "nodemailer": "^10.3.1",
    "otpauth": "^9.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query": "^5.105.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "lucide-react": "^1.67.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
