PORT=3000
# Where the SQLite database lives. Keep this on a persistent volume.
DATA_DIR=./data
# Set to "true" behind HTTPS so session cookies are Secure.
COOKIE_SECURE=false
# Cloudflare R2, through its S3 API. All uploaded and generated files live here.
# If these are empty, files are kept in DATA_DIR/files. That is for local development only.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Apple push notifications for the iOS app. If these are empty, no notifications are sent.
# APNS_KEY_BASE64 is the .p8 key from Apple, encoded with: base64 -i AuthKey_XXXX.p8
APNS_KEY_BASE64=
APNS_KEY_ID=
# Your 10-character Apple Developer Team ID, and the iOS app's bundle id.
# APNS_BUNDLE_ID defaults to dev.octax.mg, the published Octax Solobill iOS app.
APNS_TEAM_ID=
APNS_BUNDLE_ID=
# Registration and sign-in.
# The public web address, used in email links and OAuth redirects. No trailing slash.
APP_URL=http://localhost:5173
# Set to "true" to let anyone sign up. Existing users can always sign in.
REGISTRATION_OPEN=false
# Email for verification and password reset, as smtp(s)://user:pass@host:port.
# Empty outside production: emails are printed to the console instead.
SMTP_URL=
MAIL_FROM=
# Google sign-in. Client ids from Google Cloud > APIs & Services > Credentials.
# Redirect URI for the web client: <APP_URL>/api/v1/auth/oauth/google/callback
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# Sign in with Apple. Every APPLE_ value below except APPLE_SERVICES_ID can stay empty: they fall
# back to the APNS_ values, because one .p8 key with both Apple Push Notifications and Sign in with
# Apple enabled serves both. Set APPLE_KEY_ID and APPLE_PRIVATE_KEY_BASE64 only for a separate key.
# APPLE_SERVICES_ID is the web Services ID; its return URL is <APP_URL>/api/v1/auth/oauth/apple/callback
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_BASE64=
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_BUNDLE_ID=
# Password autofill between the website and the apps. The Apple team and bundle ids above are
# also used for /.well-known/apple-app-site-association, even without the Sign in with Apple key.
# For /.well-known/assetlinks.json: the Android package and the SHA-256 fingerprints of its
# signing certificates, comma separated (debug, upload and Play signing keys).
ANDROID_PACKAGE_NAME=
ANDROID_CERT_SHA256=
